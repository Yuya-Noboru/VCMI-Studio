      "CATAPULT_EXTRA_SHOTS": { "subtype": "string (Affected spell)", "val": "integer [0..3] (Mastery level)" },
      "MANUAL_CONTROL": { "subtype": "string (Creature ID)", "val": "integer [0..100] (Control chance percentage)" },
      "CHANGES_SPELL_COST_FOR_ALLY": { "val": "integer (Mana point reduction)" },
      "CHANGES_SPELL_COST_FOR_ENEMY": { "val": "integer (Mana point increase)" },
      "SPELL_RESISTANCE_AURA": { "val": "integer [0..100] (Additional magic resistance bonus percentage)" },
      "HP_REGENERATION": { "val": "integer (Health points regenerated per turn)" },
      "MANA_DRAIN": { "val": "integer (Mana points stolen per turn from enemy hero)" },
      "MANA_CHANNELING": { "val": "integer [0..100] (Percentage of mana points spent by enemy restored)" },
      "LIFE_DRAIN": { "val": "integer (Percentage of damage converted to health/resurrection)" },
      "DOUBLE_DAMAGE_CHANCE": { "val": "integer [0..100] (Double damage chance percentage)" },
